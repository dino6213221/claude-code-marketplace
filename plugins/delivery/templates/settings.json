{
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(magento2-detect *)",
      "Edit(**/var/agents/**)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash({{EXEC}} vendor/bin/phpcs *)",
      "Bash({{EXEC}} vendor/bin/phpstan *)",
      "Bash({{EXEC}} vendor/bin/phpunit *)",
      "Bash({{EXEC}} bin/magento cache:*)",
      "Bash({{EXEC}} bin/magento setup:upgrade*)",
      "Bash({{EXEC}} bin/magento indexer:*)",
      "Bash({{EXEC}} bin/magento module:status*)",
      "Bash({{EXEC}} bin/magento config:show *)",
      "Bash({{EXEC}} bin/magento info:*)",
      "Bash({{EXEC}} composer show*)",
      "Bash({{EXEC}} php -v)",
      "Bash({{EXEC}} tail *)",
      "Bash({{EXEC}} wc -l var/log/*)",
      "mcp__atlassian__*",
      "mcp__claude_ai_Atlassian__*",
      "mcp__plugin_atlassian_atlassian__*",
      "mcp__plugin_magento2_playwright__*"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git rebase *)",
      "Bash(*--no-verify*)",
      "Bash(rm -rf *)",
      "Edit(**/vendor/**)",
      "Edit(**/generated/**)",
      "Edit(**/app/etc/env.php)",
      "Read(**/app/etc/env.php)",
      "Read(**/auth.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * master*)",
      "Bash(git push * main*)",
      "Bash(git push * +*)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "mcp__atlassian__addCommentToJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__transitionJiraIssue",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__createIssueLink",
      "mcp__atlassian__addWorklogToJiraIssue",
      "mcp__atlassian__createConfluencePage",
      "mcp__atlassian__updateConfluencePage",
      "mcp__atlassian__createConfluenceFooterComment",
      "mcp__atlassian__createConfluenceInlineComment",
      "mcp__atlassian__addTeamworkGraphContext",
      "mcp__atlassian__createCompassComponent",
      "mcp__atlassian__createCompassComponentRelationship",
      "mcp__atlassian__createCompassCustomFieldDefinition",
      "mcp__claude_ai_Atlassian__addCommentToJiraIssue",
      "mcp__claude_ai_Atlassian__editJiraIssue",
      "mcp__claude_ai_Atlassian__transitionJiraIssue",
      "mcp__claude_ai_Atlassian__createJiraIssue",
      "mcp__claude_ai_Atlassian__createIssueLink",
      "mcp__claude_ai_Atlassian__addWorklogToJiraIssue",
      "mcp__claude_ai_Atlassian__createConfluencePage",
      "mcp__claude_ai_Atlassian__updateConfluencePage",
      "mcp__claude_ai_Atlassian__createConfluenceFooterComment",
      "mcp__claude_ai_Atlassian__createConfluenceInlineComment",
      "mcp__claude_ai_Atlassian__addTeamworkGraphContext",
      "mcp__claude_ai_Atlassian__createCompassComponent",
      "mcp__claude_ai_Atlassian__createCompassComponentRelationship",
      "mcp__claude_ai_Atlassian__createCompassCustomFieldDefinition",
      "mcp__plugin_atlassian_atlassian__addOrEditJiraIssueComment",
      "mcp__plugin_atlassian_atlassian__editJiraIssue",
      "mcp__plugin_atlassian_atlassian__transitionJiraIssue",
      "mcp__plugin_atlassian_atlassian__createJiraIssue",
      "mcp__plugin_atlassian_atlassian__createConfluenceContent",
      "mcp__plugin_atlassian_atlassian__updateConfluenceContent",
      "mcp__plugin_atlassian_atlassian__addGraphContext",
      "mcp__plugin_atlassian_atlassian__executeWrite",
      "mcp__plugin_atlassian_atlassian__executeDestructive"
    ]
  }
}
