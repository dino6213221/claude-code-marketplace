{
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(magento2-detect *)",
      "Edit(**/var/agents/**)",
      "Edit(**/.claude/agent-memory-local/**)",
      "Bash(bash *delivery*/scripts/stats.sh *)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash({{EXEC}} vendor/bin/phpcs *)",
      "Bash({{EXEC}} vendor/bin/phpstan *)",
      "Bash({{EXEC}} vendor/bin/phpunit *)",
      "Bash({{EXEC}} bin/magento cache:*)",
      "Bash({{EXEC}} bin/magento setup:upgrade*)",
      "Bash({{EXEC}} bin/magento indexer:*)",
      "Bash({{EXEC}} bin/magento module:status*)",
      "Bash({{EXEC}} bin/magento config:show *)",
      "Bash({{EXEC}} bin/magento info:*)",
      "Bash({{EXEC}} bin/magento store:*list*)",
      "Bash({{EXEC}} composer show*)",
      "Bash({{EXEC}} php -v)",
      "Bash({{EXEC}} tail * var/log/*)",
      "Bash({{EXEC}} wc -l var/log/*)",
      "mcp__plugin_workflow_atlassian__atlassianUserInfo",
      "mcp__plugin_workflow_atlassian__getAccessibleAtlassianResources",
      "mcp__plugin_workflow_atlassian__discover",
      "mcp__plugin_workflow_atlassian__executeRead",
      "mcp__plugin_workflow_atlassian__search",
      "mcp__plugin_workflow_atlassian__searchJiraIssuesUsingJql",
      "mcp__plugin_workflow_atlassian__getJiraIssue",
      "mcp__plugin_workflow_atlassian__listJiraIssueComments",
      "mcp__plugin_workflow_atlassian__searchConfluence",
      "mcp__plugin_workflow_atlassian__getConfluenceContent",
      "mcp__plugin_workflow_atlassian__getGraphContext",
      "mcp__plugin_workflow_atlassian__getGraphObject",
      "mcp__plugin_workflow_atlassian__getCollaborators",
      "mcp__plugin_workflow_atlassian__getPeopleInfo",
      "mcp__plugin_workflow_atlassian__getWorkActivity",
      "mcp__plugin_workflow_atlassian__getWorkPortfolio",
      "mcp__plugin_workflow_atlassian__getLoomObjectsContent",
      "mcp__plugin_magento2_playwright__*"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git rebase *)",
      "Bash(*--no-verify*)",
      "Bash(rm -rf *)",
      "Edit(**/vendor/**)",
      "Edit(**/generated/**)",
      "Edit(**/app/etc/env.php)",
      "Read(**/app/etc/env.php)",
      "Read(**/auth.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * master*)",
      "Bash(git push * main*)",
      "Bash(git push * +*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --all*)",
      "Bash(git push * *:master*)",
      "Bash(git push * *:main*)",
      "Bash(git push * *:refs/heads/master*)",
      "Bash(git push * *:refs/heads/main*)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "mcp__plugin_workflow_atlassian__addOrEditJiraIssueComment",
      "mcp__plugin_workflow_atlassian__editJiraIssue",
      "mcp__plugin_workflow_atlassian__transitionJiraIssue",
      "mcp__plugin_workflow_atlassian__createJiraIssue",
      "mcp__plugin_workflow_atlassian__createConfluenceContent",
      "mcp__plugin_workflow_atlassian__updateConfluenceContent",
      "mcp__plugin_workflow_atlassian__addGraphContext",
      "mcp__plugin_workflow_atlassian__executeWrite",
      "mcp__plugin_workflow_atlassian__executeDestructive"
    ]
  }
}
