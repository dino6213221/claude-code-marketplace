#!/usr/bin/env bash
# Detects the Magento project layout (skill magento2:verify-change, /delivery:init). Prints KEY=VALUE (empty = not detected).
# Reads only key names and non-secret values (*_ENV_TYPE, TRAEFIK_*), never app/etc/env.php or auth.json.
# Usage: magento2-detect <project directory>  (lives in the magento2 plugin's bin/ — on PATH while the plugin is enabled)
set -u
ROOT="${1:-${CLAUDE_PROJECT_DIR:-.}}"
cd "$ROOT" || exit 1

envval() { # envval <file> <key> — value of a key from a .env file (without quotes)
  [ -f "$1" ] && sed -n "s/^$2=[\"']\{0,1\}\([^\"']*\)[\"']\{0,1\}\$/\1/p" "$1" | head -1
}

# 1. Magento directory (relative to the project)
MAGENTO_ROOT=""
if [ -f bin/magento ]; then
  MAGENTO_ROOT="."
else
  M=$(find . -maxdepth 4 -path '*/bin/magento' -not -path '*/vendor/*' -not -path '*/node_modules/*' 2>/dev/null | head -1)
  [ -n "$M" ] && MAGENTO_ROOT=$(dirname "$(dirname "$M")" | sed 's#^\./##')
fi
MR="${MAGENTO_ROOT:-.}"

# 2. Local environment (there may be several candidates — then the user decides). Known: warden, reward, ddev; otherwise custom | native
ENV_CANDIDATES=""
grep -q '^WARDEN_ENV_TYPE=' .env 2>/dev/null && ENV_CANDIDATES="$ENV_CANDIDATES warden"
grep -q '^REWARD_ENV_TYPE=' .env 2>/dev/null && ENV_CANDIDATES="$ENV_CANDIDATES reward"
[ -f .ddev/config.yaml ] && ENV_CANDIDATES="$ENV_CANDIDATES ddev"
# docker-magento (markshust) and plain docker compose have no fixed command prefix → "custom" (init asks for exec/db)
if [ -z "$ENV_CANDIDATES" ]; then
  for f in compose.yaml compose.yml docker-compose.yml docker-compose.yaml; do [ -f "$f" ] && ENV_CANDIDATES="custom"; done
  # native only when Magento is in the project directory itself (commands run without cd)
  [ -z "$ENV_CANDIDATES" ] && [ "$MAGENTO_ROOT" = "." ] && command -v php >/dev/null && ENV_CANDIDATES="native"
fi
ENV_CANDIDATES=$(echo "$ENV_CANDIDATES" | xargs)
ENV_TOOL=""
[ "$(echo "$ENV_CANDIDATES" | wc -w | tr -d ' ')" = "1" ] && ENV_TOOL="$ENV_CANDIDATES"

# 3. Store URL
BASE_URL=""; MAIL_URL=""
case "$ENV_TOOL" in
  warden|reward)
    SUB=$(envval .env TRAEFIK_SUBDOMAIN); DOM=$(envval .env TRAEFIK_DOMAIN)
    [ -n "$DOM" ] && BASE_URL="https://${SUB:+$SUB.}$DOM/"
    [ "$ENV_TOOL" = warden ] && [ -n "$DOM" ] && MAIL_URL="https://webmail.$DOM/" ;;
  ddev)
    NAME=$(sed -n 's/^name: *//p' .ddev/config.yaml | head -1)
    [ -n "$NAME" ] && BASE_URL="https://$NAME.ddev.site/"
    [ -n "$NAME" ] && MAIL_URL="https://$NAME.ddev.site:8026/" ;;
esac

# 4. Frontend (may be several)
FRONTEND=""
grep -q 'hyva-themes/' "$MR/composer.json" "$MR/composer.lock" 2>/dev/null && FRONTEND="$FRONTEND hyva"
find . -maxdepth 6 -name package.json -not -path '*/node_modules/*' -not -path '*/vendor/*' 2>/dev/null \
  | xargs grep -l '@magento/pwa-buildpack\|@magento/venia-ui' 2>/dev/null | grep -q . && FRONTEND="$FRONTEND pwa"
[ -d "$MR/app/design/frontend" ] && ls "$MR/app/design/frontend"/*/*/web/js/*.js >/dev/null 2>&1 && FRONTEND="$FRONTEND luma"
FRONTEND=$(echo "$FRONTEND" | xargs)

# 5. PHP from composer.json
PHP_CONSTRAINT=$(sed -n 's/.*"php": *"\([^"]*\)".*/\1/p' "$MR/composer.json" 2>/dev/null | head -1)

# 5b. Edition (composer.json require) and MSI (app/etc/config.php module list — no secrets in that file)
EDITION=""
if [ -f "$MR/composer.json" ]; then
  if grep -Eq '"magento/(product-enterprise-edition|magento-cloud-metapackage)"' "$MR/composer.json"; then EDITION=adobe-commerce
  elif grep -q '"mage-os/' "$MR/composer.json"; then EDITION=mage-os
  elif grep -Eq '"magento/(product-community-edition|project-community-edition)"' "$MR/composer.json"; then EDITION=open-source
  fi
fi
MSI=""
if [ -f "$MR/app/etc/config.php" ]; then
  Q="[\"']"
  if grep -Eq "${Q}Magento_Inventory${Q} *=> *1" "$MR/app/etc/config.php"; then MSI=yes
  elif grep -Eq "${Q}Magento_Inventory${Q} *=> *0" "$MR/app/etc/config.php" || ! grep -Eq "${Q}Magento_Inventory${Q}" "$MR/app/etc/config.php"; then MSI=no
  fi
fi
# PHP constraint fallback: composer.lock platform requirement
[ -n "$PHP_CONSTRAINT" ] || PHP_CONSTRAINT=$(jq -r '.platform.php // empty' "$MR/composer.lock" 2>/dev/null || true)

# 6. VCS host of `origin` — only host and repository path; credentials in the URL are stripped and never printed
VCS_HOST=""; VCS_REPO=""
URL=$(git remote get-url origin 2>/dev/null || true)
if [ -n "$URL" ]; then
  HP=$(echo "$URL" | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##')     # drop scheme and user[:token]@
  HOST=$(echo "$HP" | sed -E 's#[:/].*##')
  VCS_REPO=$(echo "$HP" | sed -E 's#^[^:/]*[:/]##; s#^[0-9]+/##; s#\.git$##')
  case "$HOST" in
    *github*)    VCS_HOST=github ;;
    *bitbucket*) VCS_HOST=bitbucket ;;
    *gitlab*)    VCS_HOST=gitlab ;;
    *)           VCS_HOST=other ;;
  esac
fi
unset URL HP HOST

# 7. Tools
HAS_JQ=$(command -v jq >/dev/null && echo yes || echo no)
HAS_NPX=$(command -v npx >/dev/null && echo yes || echo no)

cat <<EOF
MAGENTO_ROOT=$MAGENTO_ROOT
ENV_CANDIDATES=$ENV_CANDIDATES
ENV_TOOL=$ENV_TOOL
BASE_URL=$BASE_URL
MAIL_URL=$MAIL_URL
FRONTEND=$FRONTEND
PHP_CONSTRAINT=$PHP_CONSTRAINT
EDITION=$EDITION
MSI=$MSI
VCS_HOST=$VCS_HOST
VCS_REPO=$VCS_REPO
HAS_JQ=$HAS_JQ
HAS_NPX=$HAS_NPX
EOF
